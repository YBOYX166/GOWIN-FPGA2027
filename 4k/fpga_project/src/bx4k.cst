// =====================================================================
// Tang Nano 4K (GW1NSR-LV4C / QFN48P) 物理约束
//
// 与 138K 主工程的 src/bx72.cst 对应的 4K 版本。
// ★ 本文件**不要**往 138K 搬 —— 管脚完全不同。
//
// 本文件覆盖 top.v 用到的全部信号：
//   Clk / Led / uart_tx / uart_rx / servo[0..3]
//
// ⚠️⚠️ 电平必须显式写 IO_TYPE=LVCMOS33 / BANK_VCCIO=3.3，不要省略！
//        省略的话 Gowin 会按 LVCMOS18 / 1.8V 处理（实测确认，引脚报告里
//        整列都是 LVCMOS18 / BankVccio=1.8）。而这些脚所在的 Bank 0 / Bank 1
//        板子是 3.3V 供电的，声明成 1.8V 就是错的。
//
//        依据是你本机的官方例程（比任何第三方资料可靠）：
//          ~/Desktop/乱七八糟/TangNano-4K-example-main/
//            led_test/.../led_test.cst      -> clk=45, led=10, rst_n=15
//            camera_hdmi/.../dk_video.cst   -> 40/41/42/43/44/45/46 全 LVCMOS33
//            key_blink/.../key_blink.cst    -> led(10) VCCIO=3.3
//                                              key(14,15) VCCIO=1.8
//        可见 Bank 3（14/15 脚）确实 1.8V，但我们用的 Bank 0/1 是 3.3V。
//
// ⚠️ 引脚 10 是 MODE 专用脚，必须在 P&R 前运行 src/pnr_dual_purpose.tcl
//    把它放开成普通 IO，否则会报 "dedicated pin (MODE)"。
// =====================================================================

// ---- 时钟 / LED ----
IO_LOC "Clk" 45;
IO_PORT "Clk" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "Led" 10;
IO_PORT "Led" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ---- 串口 ----
//   44 = TX  FPGA -> 电脑（回复上位机）
//   46 = RX  电脑 -> FPGA（接收 4 位数字指令）
//   RX 必须上拉：串口线没插时引脚悬空，上拉可以避免收到随机噪声
//   而被误判成起始位。uart_rx 内部也有同步和假起始位过滤，这里是双保险。
//
// ⚠️ 这两个脚到底连到板载 USB 还是只连到摄像头座，资料互相矛盾，需上板确认：
//      - 第三方资料（demandperipherals 的 Tang Nano 4K 支持页）说
//        44 = TX to host、46 = RX from host，即板载 USB 串口
//      - 但官方 camera_hdmi 例程把 44 当 SCL、46 当 SDA，是摄像头 I2C
//    两者不可能同时成立。**退路很稳妥**：拿一个外接 USB-TTL 模块，
//    接 44(TX) / 46(RX) / GND 三根线，一定能用，不依赖板载桥接。
IO_LOC "uart_tx" 44;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "uart_rx" 46;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ---- 4 路舵机 PWM（Slot 1，引脚 43/42/41/40，物理上挨在一起好接线）----
// 舵机信号线是高阻输入，FPGA 只管送 50Hz PWM，不涉及驱动电流。
IO_LOC "servo[0]" 43;
IO_PORT "servo[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "servo[1]" 42;
IO_PORT "servo[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "servo[2]" 41;
IO_PORT "servo[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "servo[3]" 40;
IO_PORT "servo[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// =====================================================================
// IO 展开区 —— 以后加外设时在这里逐脚加约束
// =====================================================================
//
// 约束写法（照抄改名字）：
//     IO_LOC  "arm_io[0]" 39;
//     IO_PORT "arm_io[0]" PULL_MODE=UP DRIVE=8;
//      ↑ 输出用 DRIVE=8；输入/双向用 PULL_MODE=UP（编码器、限位开关必须上拉）
//
// ⚠️ 每加一条约束，top.v 的端口列表里就必须有对应信号，一一对应。
//
// Tang Nano 4K 可用排针引脚号（已扣除板载占用）：
//
//   Slot 1: [43 42 41 40]  ← 已被 4 路舵机占用
//   Slot 2:  39 35 34 32
//   Slot 3:  31 33 16 13
//   Slot 4:  17 18 19 20
//   Slot 5:  21 22 23 27
//   Slot 6:  28 29 30
//
//   已被板载占用，不要在排针上复用：
//     45 = 27MHz 时钟（本文件的 Clk）
//     44 = UART TX（本文件的 uart_tx）
//     46 = UART RX（本文件的 uart_rx）
//     10 = 板载红色 LED（本文件的 Led）
//     15 = 复位按键
//     14 = 另一个按键
//
// ⚠️⚠️ 这块板有 **三种不同的 IO 电压**，部分排针槽内混压。
//      实测（见本文件顶部注释）：Bank 0/1 = 3.3V，Bank 3（14/15 脚）= 1.8V，
//      Bank 2（33 脚）官方例程用 LVCMOS25 = 2.5V。
//      加新脚时**一定要显式写** IO_TYPE / BANK_VCCIO，别靠默认值。
//
// ⚠️ 47 / 48 脚**不要碰**（实测结论）：
//      脚 47 = MI/D7、脚 48 = MO/D6，是外部配置 Flash 的 SPI 数据脚
//      （配套 1 脚 MCLK、2 脚 MCS_N）。
//      直接约束会报：
//          ERROR (PR2017) ... the location is a dedicated pin (MSPI)
//      加 set_option -use_mspi_as_gpio 1 后确实能用（实测 P&R 通过、能出
//      比特流），但代价是**放弃从 Flash 启动**，以后每次上电都得用 JTAG
//      烧 SRAM，掉电就没了。除非你明确要这个代价，否则别用。
//
// ---- 示例：再加 2 路舵机 ----
// IO_LOC "arm_io[0]" 39;
// IO_PORT "arm_io[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// IO_LOC "arm_io[1]" 35;
// IO_PORT "arm_io[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
//
// ---- 示例：增量编码器输入（必须上拉）----
// IO_LOC "enc_a[0]" 34;
// IO_PORT "enc_a[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// IO_LOC "enc_b[0]" 32;
// IO_PORT "enc_b[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// =====================================================================
