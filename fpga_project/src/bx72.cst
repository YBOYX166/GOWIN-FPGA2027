// ---- GPIO1：电机驱动 + 编码器（接 2 片 AT8236 四驱麦轮，详见 PROJECT_INTERFACE.md） ----
// Gpio1[3:0]   PWM0..3    出  两片 AT8236 的 PWMA/PWMB
// Gpio1[7:4]   IN1_0..3   出  AIN1/BIN1
// Gpio1[11:8]  IN2_0..3   出  AIN2/BIN2
// Gpio1[13:12] STBY0/1    出  两片 AT8236 使能
// Gpio1[17:14] ENC_A0..3  入  编码器 A 相（上拉）
// Gpio1[21:18] ENC_B0..3  入  编码器 B 相（上拉）
// Gpio1[28]    LCD_R5     出  归 LCD 用，与电机无关
// Gpio1[35:22]、[29] 未用
IO_LOC "Gpio1[0]" F13;
IO_PORT "Gpio1[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
IO_LOC "Gpio1[1]" F14;
IO_PORT "Gpio1[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=24 BANK_VCCIO=3.3;
