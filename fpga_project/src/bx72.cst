// =====================================================================
// BX72 (GW5AT-138) 物理约束 —— OV5640 摄像头 + LCD 工程
// 仅覆盖 top.v 用到的信号：Clk / Rst_n / Led / camera_io / Gpio0 / Gpio1
// 完整管脚表见 BX72管脚分配表V2.1.md
// =====================================================================

// ---- 时钟 / 复位 ----
IO_LOC "Clk" Y18;
IO_PORT "Clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "Rst_n" V17;
IO_PORT "Rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ---- 板载 USB-UART ----
//   TX (N14)：编码器速度上报，每 200ms 一行，见 enc_report.v
//   RX (N13)：上位机遥控指令输入，见 cmd_rx.v
IO_LOC "uart_tx" N14;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "uart_rx" N13;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ---- LED ----
IO_LOC "Led[0]" Y19;
IO_PORT "Led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "Led[1]" AA18;
IO_PORT "Led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

